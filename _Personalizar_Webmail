  cat > "$MODROOT/hostlp.js" <<'JS'
(function () {
  try {
    var KEY = 'hlpRail', root = document.documentElement;
    try { if (localStorage.getItem(KEY) === '1') root.classList.add('hlp-rail'); } catch (e) {}
    function toggle() {
      root.classList.toggle('hlp-rail');
      try { localStorage.setItem(KEY, root.classList.contains('hlp-rail') ? '1' : '0'); } catch (e) {}
    }
    function marcaApp() {
      try {
        var m = location.pathname.match(/^\/modern\/([a-z]+)/);
        var app = m ? m[1] : 'email';
        if (root.getAttribute('data-hlp-app') !== app) root.setAttribute('data-hlp-app', app);
      } catch (e) {}
    }
    function addBtn() {
      if (document.getElementById('hlp-rail-btn')) return;
      var b = document.createElement('button');
      b.id = 'hlp-rail-btn'; b.type = 'button';
      b.title = 'Recolher ou expandir o menu'; b.setAttribute('aria-label', 'Recolher ou expandir o menu');
      b.addEventListener('click', toggle);
      document.body.appendChild(b);
    }
    function limpa(s) { return (s || '').replace(/\s+/g, ' ').replace(/^\s*\+\s*/, '').trim(); }
    function texto(el) { return limpa(el && el.textContent); }

    var tip = null, alvo = null, tmr = null;
    function esconde() {
      clearTimeout(tmr); alvo = null;
      if (tip) tip.classList.remove('on');
    }
    function mostra(el) {
      try {
        var t = el.getAttribute('data-hlp-tip');
        if (!t || !el.isConnected) return;
        if (!tip) { tip = document.createElement('div'); tip.id = 'hlp-tip'; tip.setAttribute('role', 'tooltip'); document.body.appendChild(tip); }
        tip.classList.remove('on'); tip.textContent = t;
        tip.style.left = '-9999px'; tip.style.top = '-9999px';
        var r = el.getBoundingClientRect(), w = tip.offsetWidth, h = tip.offsetHeight, x, y;
        var naFaixa = root.classList.contains('hlp-rail') && el.closest('.zimbra-client_sidebar');
        if (naFaixa) { x = r.right + 10; y = r.top + r.height / 2 - h / 2; }
        else {
          x = r.left + r.width / 2 - w / 2; y = r.bottom + 8;
          if (y + h > window.innerHeight - 4) y = r.top - h - 8;
        }
        x = Math.max(6, Math.min(x, window.innerWidth - w - 6));
        y = Math.max(6, y);
        tip.style.left = Math.round(x) + 'px'; tip.style.top = Math.round(y) + 'px';
        requestAnimationFrame(function () { if (alvo === el) tip.classList.add('on'); });
      } catch (e) {}
    }
    document.addEventListener('mouseover', function (ev) {
      try {
        if (!ev.target.closest) return;
        var a = ev.target.closest('.zimbra-client_folder-list_itemLink, .zimbra-client_folder-list_tagLink, .zimbra-client_sidebar-primary-button_button');
        if (a && !a.getAttribute('title') && !a.getAttribute('data-hlp-tip')) a.setAttribute('title', texto(a));
        var p = ev.target.closest('.zimbra-client_folder-list_customFolderToggle button');
        if (p && !p.getAttribute('data-hlp-title')) {
          var rot = limpa(p.getAttribute('title') || p.getAttribute('aria-label'));
          if (!rot) {
            var g = p.closest('.zimbra-client_folder-list_customFolderToggle');
            var nome = texto(g && g.querySelector('.zimbra-client_folder-list_customFolderToggleName'));
            rot = /pasta/i.test(nome) ? 'Nova pasta' : (nome ? 'Adicionar em ' + nome : 'Adicionar');
          }
          p.setAttribute('title', rot); p.setAttribute('data-hlp-title', '1');
        }
        var el = ev.target.closest('[title], [data-hlp-tip]');
        if (!el || !(el.closest('#zimbra-client') || el.id === 'hlp-rail-btn')) return;
        var tt = el.getAttribute('title');
        if (tt) {
          el.setAttribute('data-hlp-tip', limpa(tt));
          if (!el.getAttribute('aria-label')) el.setAttribute('aria-label', limpa(tt));
          el.removeAttribute('title');
        }
        if (alvo === el) return;
        esconde(); alvo = el;
        tmr = setTimeout(function () { if (alvo === el) mostra(el); }, 350);
      } catch (e) {}
    });
    document.addEventListener('mouseout', function (ev) {
      try {
        if (alvo && (!ev.relatedTarget || !alvo.contains(ev.relatedTarget))) {
          if (ev.target === alvo || alvo.contains(ev.target)) esconde();
        }
      } catch (e) {}
    });
    ['mousedown', 'wheel', 'keydown', 'blur'].forEach(function (n) { window.addEventListener(n, esconde, true); });

    marcaApp(); setInterval(marcaApp, 500);
    if (document.readyState !== 'loading') addBtn(); else document.addEventListener('DOMContentLoaded', addBtn);
  } catch (e) {}
})();
