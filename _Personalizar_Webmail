#!/bin/bash
# _Personalizar_Webmail -- tela de login + Modern UI HostLP (idempotente). Rodar como root apos cada atualizacao do Zimbra.
# Uso: _Personalizar_Webmail            -> aplica tudo (login + Modern UI) e reinicia o mailboxd
#      _Personalizar_Webmail --modern   -> aplica so o Modern UI (sem restart; arquivos estaticos)
#      _Personalizar_Webmail --favicon  -> so sincroniza o favicon do Modern UI com o site (cron diario, sem restart)
# Fundo do login e favicon do login ficam ONLINE (site.hostlp.com.br).
set -u
IMG_URL="https://site.hostlp.com.br/imagens/zimbra/zimbra_webmail.png"
ICO_URL="https://site.hostlp.com.br/imagens/zimbra/favicon.ico"
TITULO="Webmail"
BOTAO="Acessar"
WEB=/opt/zimbra/jetty/webapps/zimbra
SKIN=$WEB/skins/zextras
MSG=$WEB/WEB-INF/classes/messages
MODROOT=$WEB/modern
MOD=$MODROOT/clients/default
SW=$MODROOT/sw.js

chaves() { echo "$(tr -cd '{' < "$1" | wc -c) $(tr -cd '}' < "$1" | wc -c)"; }
gz() { gzip -9 -k -f "$1"; chown zimbra:zimbra "$1.gz"; rm -f "$1.br"; }
# swrev URL ARQUIVO -- grava o md5 do arquivo como revisao do pre-cache no sw.js
swrev() { local h; h=$(md5sum "$2" | cut -c1-32); sed -i -E "s#(\{url:\"$1\",revision:\")[0-9a-f]+\"#\1${h}\"#" "$SW"; }
sync_favicon() {
  local tmp host ip
  tmp=$(mktemp); host=$(echo "$ICO_URL" | awk -F/ '{print $3}')
  if ! curl -fsSL "$ICO_URL" -o "$tmp"; then
    ip=$(dig +short "$host" @1.1.1.1 | grep -E '^[0-9.]+$' | tail -1)
    [ -n "$ip" ] && curl -fsSL --resolve "$host:443:$ip" "$ICO_URL" -o "$tmp"
  fi
  if [ -s "$tmp" ] && file -b --mime-type "$tmp" | grep -qE '^image/(vnd.microsoft.icon|x-icon)$'; then
    if ! cmp -s "$tmp" "$MOD/assets/favicon.ico"; then
      install -o zimbra -g zimbra -m 644 "$tmp" "$MOD/assets/favicon.ico"; gz "$MOD/assets/favicon.ico"
      swrev "/modern/clients/default/assets/favicon.ico" "$MOD/assets/favicon.ico"; gz "$SW"
      echo "favicon modern: atualizado"
    else
      echo "favicon modern: sem mudanca"
    fi
  else
    echo "favicon modern: FALHA no download (mantido o atual)"
  fi
  rm -f "$tmp"
}

aplicar_modern() {
  mkdir -p "$BK/modern"
  cp -a "$MOD/config.json" "$MOD/assets/favicon.ico" "$MODROOT/index.html" "$SW" "$BK/modern/"; cp -a "$MOD/pwa/manifest.json" "$BK/modern/"
  for f in hostlp.css hostlp.js; do [ -f "$MODROOT/$f" ] && cp -a "$MODROOT/$f" "$BK/modern/"; done

  # titulo e cores da marca (JSON editado como JSON)
  python3 - "$MOD/config.json" "$MOD/pwa/manifest.json" "$TITULO" <<'PY'
import json, sys
cfg, man, tit = sys.argv[1], sys.argv[2], sys.argv[3]
c = json.load(open(cfg))
c["title"] = tit; c["clientName"] = tit
c.update({"svgIcon": "#0b2a6b", "brandPrimary": "#0b2a6b", "brandSecondary": "#2cb4dc",
          "brandTertiary": "#0b2a6b", "backgroundColor": "#0b2a6b", "themeColor": "#0b2a6b"})
c.setdefault("faviconBadge", {})["onlineTextColor"] = "#0b2a6b"
open(cfg, "w").write(json.dumps(c, indent=2, ensure_ascii=False) + "\n")
m = json.load(open(man))
m["name"] = tit; m["short_name"] = tit
for k in ("theme_color", "background_color"):
    if k in m: m[k] = "#0b2a6b"
open(man, "w").write(json.dumps(m, indent=2, ensure_ascii=False) + "\n")
print("modern: json ok")
PY

  # icones do modo compacto (e limpeza dos icones de teste antigos)
  cat > "$MODROOT/hostlp_menu.svg" <<'SVG'
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#33415c" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
SVG
  cat > "$MODROOT/hostlp_pencil.svg" <<'SVG'
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
SVG
  rm -f "$MODROOT"/hostlp_cal.svg "$MODROOT"/hostlp_user.svg "$MODROOT"/hostlp_upload.svg "$MODROOT"/hostlp_plus.svg
  chown zimbra:zimbra "$MODROOT"/hostlp_*.svg; chmod 644 "$MODROOT"/hostlp_*.svg

