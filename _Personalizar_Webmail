  # injeta <link> e <script> no index.html (depois do bundle), com versao para furar cache
  local VC VJ
  VC=$(md5sum "$MODROOT/hostlp.css" | cut -c1-10); VJ=$(md5sum "$MODROOT/hostlp.js" | cut -c1-10)
  perl -0pi -e 's{<link id="hostlp-css"[^>]*>}{}g; s{<script id="hostlp-js"[^>]*></script>}{}g' "$MODROOT/index.html"
  perl -0pi -e "s{</head>}{<link id=\"hostlp-css\" href=\"/modern/hostlp.css?v=${VC}\" rel=\"stylesheet\"><script id=\"hostlp-js\" src=\"/modern/hostlp.js?v=${VJ}\" defer></script></head>}" "$MODROOT/index.html"
  echo "modern: index.html ->"; grep -oE '<(link|script) id="hostlp-(css|js)"[^>]*>' "$MODROOT/index.html"

  # favicon, recompactacao e revisoes do service worker
  sync_favicon
  for f in "$MOD/config.json" "$MOD/pwa/manifest.json" "$MODROOT/index.html"; do gz "$f"; done
  swrev "/modern/index.html" "$MODROOT/index.html"
  swrev "/modern/clients/default/config.json" "$MOD/config.json"
  swrev "/modern/clients/default/pwa/manifest.json" "$MOD/pwa/manifest.json"
  swrev "/modern/clients/default/assets/favicon.ico" "$MOD/assets/favicon.ico"
  gz "$SW"
  echo "modern: revisoes no sw.js ->"
  grep -oE '\{url:"/modern/(index\.html|clients/default/(config\.json|pwa/manifest\.json|assets/favicon\.ico))",revision:"[0-9a-f]+"\}' "$SW"

  # cron diario do favicon do Modern UI
  cat > /etc/cron.d/hostlp-webmail-favicon <<'CRON'
# Sincroniza o favicon do Modern UI com site.hostlp.com.br (sem reiniciar servicos)
15 4 * * * root /Scripts_Zimbra/_Personalizar_Webmail --favicon >/dev/null 2>&1
CRON
  chmod 644 /etc/cron.d/hostlp-webmail-favicon
  echo "cron: /etc/cron.d/hostlp-webmail-favicon ok"
}

