#!/bin/bash
# _Backup_Restore_Briefcase (v2) -- backup e restore do Porta-arquivos (Briefcase) do Zimbra.
#
# Uso:
#   _Backup_Restore_Briefcase                              -> menu interativo
#   _Backup_Restore_Briefcase --backup  [--conta a@b,c@d] [--paralelo N]
#   _Backup_Restore_Briefcase --restore [--conta a@b,c@d] [--paralelo N] [--aplicar]
#        (sem --aplicar = SIMULACAO: so lista o que seria corrigido, nao altera nada)
#   _Backup_Restore_Briefcase --listar                     -> lista os backups disponiveis
#
# Backup:  cada execucao grava numa pasta nova  $BASE/AAAAMMDD_HHMMSS/<conta>.tgz
#          (nunca sobrescreve backups anteriores; .tgz validado antes de ser aceito;
#           so processa contas que tem documentos; contas em paralelo).
# Restore: corrige SO os documentos do Briefcase que nao abrem (teste de leitura real),
#          pegando a versao mais recente do arquivo no backup mais novo que o tenha
#          (pastas novas e, por ultimo, os .tgz antigos soltos em $BASE).
#          Documentos que abrem normalmente NAO sao tocados.
set -u

BASE=/opt/zimbra/tmp/backup_briefcase
LOG_DIR=/var/log/zextras_briefcase
RETER=7            # pastas de backup novas mantidas (os .tgz antigos soltos em $BASE nunca sao apagados)
PARALELO=4
LOCK=/var/lock/backup_restore_briefcase.lock
ACAO=""; CONTAS=""; APLICAR=0

mkdir -p "$LOG_DIR"
cd /tmp || exit 1

ZM()     { runuser -u zimbra -- env HOME=/opt/zimbra /opt/zimbra/bin/zmmailbox -z "$@" < /dev/null; }
ZMPROV() { runuser -u zimbra -- env HOME=/opt/zimbra /opt/zimbra/bin/zmprov "$@" < /dev/null; }
SQL()    { runuser -u zimbra -- env HOME=/opt/zimbra /opt/zimbra/bin/mysql --default-character-set=utf8mb4 -N -B -e "$1" < /dev/null; }
log()    { printf '%s\n' "$*"; printf '%s - %s\n' "$(date '+%F %T')" "$*" >> "$LOG"; }
export -f ZM SQL log

# ---------------------------------------------------------------- contas alvo
contas_alvo() {
  if [ -n "$CONTAS" ]; then tr ',' '\n' <<< "$CONTAS" | sed '/^\s*$/d' | tr 'A-Z' 'a-z' | sort -u; return; fi
  local g q="" grupos
  grupos=$(SQL "select distinct group_id from zimbra.mailbox") || return 1
  for g in $grupos; do
    q="$q${q:+ union all }select mailbox_id from mboxgroup$g.mail_item where type=8 group by mailbox_id"
  done
  [ -z "$q" ] && return 0
  local com_docs ldap
  com_docs=$(SQL "select lower(m.comment) from zimbra.mailbox m join ($q) d on d.mailbox_id=m.id" | sort -u)
  ldap=$(ZMPROV -l gaa | tr 'A-Z' 'a-z' | sort -u)
  comm -23 <(printf '%s\n' "$com_docs") <(printf '%s\n' "$ldap") | sed '/^$/d' | while read -r x; do
    log "AVISO: caixa com documentos sem conta correspondente no LDAP (conta renomeada?): $x"
  done
  comm -12 <(printf '%s\n' "$com_docs") <(printf '%s\n' "$ldap") | sed '/^$/d'
}

# ---------------------------------------------------------------- backup
backup_conta() {
  local a=$1 part="$RUN/$1.tgz.part" n
  if ZM -m "$a" gru '/Briefcase/?fmt=tgz' > "$part" 2>> "$RUN/.erros.log" \
     && [ -s "$part" ] && tar -tzf "$part" > /dev/null 2>&1; then
    n=$(tar -tzf "$part" | grep -v '\.meta$' | grep -c '^Briefcase/')
    if [ "$n" -gt 0 ]; then
      mv -f "$part" "$RUN/$a.tgz"; chmod 640 "$RUN/$a.tgz"
      echo "OK $a $n" >> "$RUN/.status"; log "Backup OK: $a ($n arquivos, $(du -h "$RUN/$a.tgz" | cut -f1))"
    else
      rm -f "$part"; echo "VAZIO $a 0" >> "$RUN/.status"; echo ">> Briefcase vazio: $a"
    fi
  else
    rm -f "$part"; echo "FALHA $a 0" >> "$RUN/.status"; log "FALHA no backup: $a (detalhe em $RUN/.erros.log)"
  fi
}
export -f backup_conta

backup() {
  LOG="$LOG_DIR/backup_$(date +%Y%m%d_%H%M%S).log"; export LOG
  RUN="$BASE/$(date +%Y%m%d_%H%M%S)"; export RUN
  mkdir -p "$RUN"; : > "$RUN/.status"; : > "$RUN/.erros.log"; chmod 750 "$BASE" "$RUN"
  local lista total
  lista=$(contas_alvo) || { log "ERRO: nao consegui listar as contas"; return 1; }
  total=$(printf '%s\n' "$lista" | sed '/^$/d' | wc -l)
  log "Backup em: $RUN | contas com documentos: $total | paralelo: $PARALELO"
  printf '%s\n' "$lista" | sed '/^$/d' | xargs -r -P "$PARALELO" -I{} bash -c 'backup_conta "$1"' _ {}
  local ok vz fl
  ok=$(grep -c '^OK ' "$RUN/.status"); vz=$(grep -c '^VAZIO ' "$RUN/.status"); fl=$(grep -c '^FALHA ' "$RUN/.status")
  log "Resumo: OK=$ok VAZIO=$vz FALHA=$fl | pasta: $RUN"
  [ "$fl" -gt 0 ] && log "Contas com FALHA: $(awk '/^FALHA /{printf "%s ", $2}' "$RUN/.status")"
  # retencao: so as pastas novas (AAAAMMDD_HHMMSS); os .tgz antigos soltos em $BASE ficam
  ls -1d "$BASE"/20[0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9] 2>/dev/null | sort | head -n -"$RETER" | while read -r d; do
    rm -rf -- "$d"; log "Retencao: removido backup antigo $d"
  done
  [ "$fl" -eq 0 ]
}

# ---------------------------------------------------------------- restore
fontes_da_conta() {   # .tgz da conta, do mais novo para o mais antigo
  local a=$1 d
  ls -1d "$BASE"/20[0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9] 2>/dev/null | sort -r | while read -r d; do
    [ -s "$d/$a.tgz" ] && echo "$d/$a.tgz"
  done
  [ -s "$BASE/$a.tgz" ] && echo "$BASE/$a.tgz"
}

indexar_tgz() {       # chave "/Briefcase/pasta/nome" <TAB> membro da versao mais recente
  python3 - "$1" <<'PY'
import sys, tarfile, re
best = {}
try:
    with tarfile.open(sys.argv[1], 'r:gz') as t:
        for m in t.getmembers():
            if not m.isfile() or m.name.endswith('.meta'):
                continue
            n = m.name[2:] if m.name.startswith('./') else m.name
            if not n.startswith('Briefcase/'):
                continue
            d, _, f = n.rpartition('/')
            mt = re.match(r'^(.*)-(\d{5})(\.[^./]*)?$', f)
            base, v = (mt.group(1) + (mt.group(3) or ''), int(mt.group(2))) if mt else (f, 0)
            k = '/' + d + '/' + base
            if k not in best or v > best[k][0]:
                best[k] = (v, m.name)
except Exception as e:
    sys.stderr.write('tgz invalido: %s (%s)\n' % (sys.argv[1], e))
    sys.exit(1)
for k, (v, n) in best.items():
    print(k + '\t' + n)
PY
}

testar_doc() {        # "<id> OK" ou "<id> QUEBRADO"
  local id=$1 size=$2 n
  [ "$size" = 0 ] && { echo "$id OK"; return; }
  n=$(ZM -m "$CONTA" gru "/?id=$id" 2>/dev/null | head -c 1 | wc -c)
  [ "$n" = 1 ] && echo "$id OK" || echo "$id QUEBRADO"
}
export -f testar_doc

restore_conta() {
  local a=$1 W="$WORK/$1" mid gid
  CONTA=$a; export CONTA
  mkdir -p "$W"; chown zimbra:zimbra "$W"; chmod 700 "$W"
  read -r mid gid < <(SQL "select id, group_id from zimbra.mailbox where lower(comment)='$a'")
  [ -z "${mid:-}" ] && { log "[$a] sem caixa no banco, pulando"; return; }

  # documentos do banco e pastas da conta
  SQL "select id, folder_id, size, name from mboxgroup$gid.mail_item where mailbox_id=$mid and type=8" > "$W/docs.tsv"
  ZM -m "$a" gaf 2>/dev/null | awk '$1 ~ /^[0-9]+$/ { id=$1; sub(/^ *[0-9]+ +[a-z]+ +[0-9]+ +[0-9]+ +/, ""); print id "\t" $0 }' > "$W/pastas.tsv"
  awk -F'\t' 'NR==FNR { p[$1]=$2; next } ($2 in p) && (p[$2]=="/Briefcase" || index(p[$2], "/Briefcase/")==1) { print $1 "\t" $3 "\t" p[$2] "\t" $4 }' \
      "$W/pastas.tsv" "$W/docs.tsv" > "$W/briefcase.tsv"
  local total; total=$(wc -l < "$W/briefcase.tsv")
  [ "$total" -eq 0 ] && { log "[$a] nenhum documento no Briefcase"; return; }

  # teste de leitura real, em paralelo
  cut -f1,2 "$W/briefcase.tsv" | xargs -r -P "$PARALELO" -n 2 bash -c 'testar_doc "$1" "$2"' _ > "$W/teste.txt"
  local nq; nq=$(grep -c ' QUEBRADO$' "$W/teste.txt")
  log "[$a] documentos: $total | abrem: $((total - nq)) | nao abrem: $nq"
  T_DOCS=$((T_DOCS + total)); T_QUEB=$((T_QUEB + nq))
  [ "$nq" -eq 0 ] && return

  # indices dos backups da conta (mais novo primeiro)
  local fontes=() f i=0
  while read -r f; do [ -n "$f" ] && fontes+=("$f"); done < <(fontes_da_conta "$a")
  for f in "${fontes[@]}"; do indexar_tgz "$f" > "$W/idx_$i.tsv" 2>> "$LOG" || : > "$W/idx_$i.tsv"; i=$((i + 1)); done

  local id size path name chave membro origem j arq lido
  grep ' QUEBRADO$' "$W/teste.txt" | cut -d' ' -f1 | while read -r id; do
    IFS=$'\t' read -r _ size path name < <(awk -F'\t' -v x="$id" '$1==x' "$W/briefcase.tsv")
    chave="$path/$name"; membro=""; origem=""
    for ((j = 0; j < ${#fontes[@]}; j++)); do
      membro=$(awk -F'\t' -v k="$chave" '$1==k { print $2; exit }' "$W/idx_$j.tsv")
      [ -n "$membro" ] && { origem=${fontes[$j]}; break; }
    done
    if [ -z "$membro" ]; then
      log "[$a] SEM BACKUP: $chave (item $id)"; echo x >> "$WORK/.sem_backup"; continue
    fi
    if [ "$APLICAR" -ne 1 ]; then
      log "[$a] CORRIGIRIA: $chave (item $id) <- $(basename "$(dirname "$origem")")/$(basename "$origem") : $membro"; continue
    fi
    tar -xzf "$origem" -C "$W" -- "$membro" 2>> "$LOG" < /dev/null
    arq="$W/$membro"
    if [ ! -s "$arq" ]; then log "[$a] ERRO extraindo $membro de $origem"; echo x >> "$WORK/.erros"; continue; fi
    chown -R zimbra:zimbra "$W"
    if ! ZM -m "$a" deleteItem "$id" >> "$LOG" 2>&1; then
      log "[$a] ERRO removendo item $id ($chave); nada alterado"; echo x >> "$WORK/.erros"; continue
    fi
    ZM -m "$a" pru "$chave" "$arq" >> "$LOG" 2>&1
    lido=$(ZM -m "$a" gru "$chave" 2>/dev/null | wc -c)
    if [ "$lido" = "$(stat -c %s "$arq")" ]; then
      log "[$a] CORRIGIDO: $chave ($lido bytes)"; echo x >> "$WORK/.corrigidos"
    else
      log "[$a] ERRO ao regravar $chave (copia em $arq; refazer: zmmailbox -z -m $a pru \"$chave\" \"$arq\")"; echo x >> "$WORK/.erros"
    fi
  done
}

restore() {
  local modo="SIMULACAO"; [ "$APLICAR" -eq 1 ] && modo="APLICAR"
  LOG="$LOG_DIR/restore_$(date +%Y%m%d_%H%M%S).log"; export LOG
  WORK="/opt/zimbra/tmp/restore-briefcase-$(date +%Y%m%d_%H%M%S)"; mkdir -p "$WORK"; chown zimbra:zimbra "$WORK"; chmod 700 "$WORK"
  : > "$WORK/.corrigidos"; : > "$WORK/.sem_backup"; : > "$WORK/.erros"
  T_DOCS=0; T_QUEB=0
  local lista a
  lista=$(contas_alvo) || { log "ERRO: nao consegui listar as contas"; return 1; }
  log "Restore ($modo) | contas: $(printf '%s\n' "$lista" | sed '/^$/d' | wc -l) | trabalho: $WORK"
  while read -r a; do [ -n "$a" ] && restore_conta "$a"; done <<< "$lista"
  log "Resumo ($modo): documentos=$T_DOCS nao_abrem=$T_QUEB corrigidos=$(wc -l < "$WORK/.corrigidos") sem_backup=$(wc -l < "$WORK/.sem_backup") erros=$(wc -l < "$WORK/.erros")"
  [ "$APLICAR" -ne 1 ] && log "Nada foi alterado. Para corrigir, rode de novo com --aplicar."
  log "Log: $LOG"
}

listar() {
  echo "Backups novos (pasta por execucao):"
  ls -1d "$BASE"/20[0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9] 2>/dev/null | sort -r | while read -r d; do
    printf '  %s  contas=%s  falhas=%s  %s\n' "$(basename "$d")" "$(ls "$d"/*.tgz 2>/dev/null | wc -l)" \
      "$(grep -c '^FALHA ' "$d/.status" 2>/dev/null || echo 0)" "$(du -sh "$d" | cut -f1)"
  done
  echo "Backups antigos (soltos em $BASE): $(ls "$BASE"/*.tgz 2>/dev/null | wc -l) arquivos"
}

# ---------------------------------------------------------------- execucao
exec 9> "$LOCK"
flock -n 9 || { echo "Ja existe outra execucao deste script em andamento."; exit 1; }

while [ $# -gt 0 ]; do
  case "$1" in
    --backup)   ACAO=backup ;;
    --restore)  ACAO=restore ;;
    --listar)   ACAO=listar ;;
    --aplicar)  APLICAR=1 ;;
    --conta)    CONTAS=${2:-}; shift ;;
    --paralelo) PARALELO=${2:-4}; shift ;;
    *) echo "Opcao invalida: $1"; exit 1 ;;
  esac
  shift
done
export PARALELO

case "$ACAO" in
  backup)  backup; exit $? ;;
  restore) restore; exit $? ;;
  listar)  listar; exit 0 ;;
esac

while true; do
  clear
  echo "===================================="
  echo "  GERENCIADOR ZIMBRA BRIEFCASE SUITE"
  echo "===================================="
  echo
  echo "1. Realizar Backup"
  echo "2. Simular Restauracao (nao altera nada)"
  echo "3. Restaurar (corrige os documentos que nao abrem)"
  echo "4. Listar backups"
  echo "5. Sair"
  echo
  read -r -p "Selecione uma opcao [1-5]: " OPT
  case "$OPT" in
    1) read -r -p "Contas (separadas por virgula, vazio = todas): " CONTAS; backup ;;
    2) read -r -p "Contas (separadas por virgula, vazio = todas): " CONTAS; APLICAR=0; restore ;;
    3) read -r -p "Contas (separadas por virgula, vazio = todas): " CONTAS
       read -r -p "Confirma a CORRECAO (digite SIM): " C
       [ "$C" = "SIM" ] && { APLICAR=1; restore; } || echo "Cancelado." ;;
    4) listar ;;
    5) echo "Saindo..."; exit 0 ;;
    *) echo "Opcao invalida!"; sleep 1; continue ;;
  esac
  read -r -p "Pressione Enter para continuar..." _
done
